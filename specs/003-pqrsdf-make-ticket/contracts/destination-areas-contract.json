{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetDestinationAreasContract",
  "description": "API contract for querying active destination areas for PQRSDF filings (GET /api/v1/pqrsdf/areas)",
  "endpoint": {
    "method": "GET",
    "path": "/api/v1/pqrsdf/areas",
    "summary": "Retrieve active organizational areas eligible to receive filings",
    "authenticated": false
  },
  "request": {
    "type": "null",
    "description": "No query parameters required"
  },
  "responses": {
    "200": {
      "description": "List of active destination areas",
      "content": {
        "application/json": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "code"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "description": "Unique area identifier"
              },
              "name": {
                "type": "string",
                "example": "Atención al Ciudadano",
                "description": "Spanish display name of the administrative area"
              },
              "code": {
                "type": "string",
                "example": "ATC",
                "description": "Short code representing the area"
              }
            }
          }
        }
      }
    },
    "500": {
      "description": "Internal server error (RFC 7807 ProblemDetails)",
      "content": {
        "application/problem+json": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "integer", "example": 500 },
            "detail": { "type": "string" }
          }
        }
      }
    }
  }
}
