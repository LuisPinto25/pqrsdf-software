{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MakePqrsdfContract",
  "description": "API contract for submitting a new PQRSDF ticket (POST /api/v1/pqrsdf)",
  "endpoint": {
    "method": "POST",
    "path": "/api/v1/pqrsdf",
    "summary": "Submit a new public PQRSDF ticket",
    "authenticated": false
  },
  "request": {
    "type": "object",
    "required": [
      "type",
      "destinationAreaId",
      "subject",
      "description"
    ],
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "Petition",
          "Complaint",
          "Claim",
          "Suggestion",
          "Denunciation",
          "Compliment"
        ],
        "description": "Category of the PQRSDF"
      },
      "destinationAreaId": {
        "type": "string",
        "format": "uuid",
        "description": "Identifier of the active destination administrative unit"
      },
      "isAnonymous": {
        "type": "boolean",
        "default": false,
        "description": "Indicates if the ticket is filed anonymously (valid only for Suggestion and Denunciation)"
      },
      "applicant": {
        "type": ["object", "null"],
        "description": "Applicant personal and contact details. Required if isAnonymous is false.",
        "required": [
          "fullName",
          "identificationType",
          "identificationNumber",
          "email"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150,
            "description": "Full name of the citizen"
          },
          "identificationType": {
            "type": "string",
            "enum": ["CC", "CE", "TI", "PA", "NIT"],
            "description": "Type of identity document"
          },
          "identificationNumber": {
            "type": "string",
            "minLength": 4,
            "maxLength": 20,
            "description": "Alphanumeric identity document number"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Valid email address for notification"
          },
          "phoneNumber": {
            "type": ["string", "null"],
            "maxLength": 20,
            "description": "Optional contact telephone number"
          }
        }
      },
      "subject": {
        "type": "string",
        "minLength": 5,
        "maxLength": 150,
        "description": "Plain text summary of the ticket"
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "maxLength": 4000,
        "description": "Detailed plain text explanation of the ticket"
      }
    }
  },
  "responses": {
    "201": {
      "description": "Ticket successfully registered",
      "content": {
        "application/json": {
          "type": "object",
          "required": [
            "id",
            "radicadoNumber",
            "type",
            "createdAtUtc",
            "dueDate",
            "businessDaysCount",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Internal ticket identifier"
            },
            "radicadoNumber": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{8}$",
              "example": "2026-00000001",
              "description": "Official sequential tracking number"
            },
            "type": {
              "type": "string",
              "description": "Registered PQRSDF type"
            },
            "createdAtUtc": {
              "type": "string",
              "format": "date-time",
              "description": "Registration timestamp in UTC"
            },
            "dueDate": {
              "type": "string",
              "format": "date",
              "example": "2026-10-09",
              "description": "Maximum legal response date (statutory business days)"
            },
            "businessDaysCount": {
              "type": "integer",
              "enum": [15, 30],
              "description": "Count of official Colombian business days granted"
            },
            "status": {
              "type": "string",
              "example": "Registered",
              "description": "Initial lifecycle state"
            }
          }
        }
      }
    },
    "400": {
      "description": "Input validation failure (RFC 7807 ProblemDetails)",
      "content": {
        "application/problem+json": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "integer", "example": 400 },
            "detail": { "type": "string" },
            "errors": { "type": "object" }
          }
        }
      }
    },
    "422": {
      "description": "Domain business rule violation (e.g., anonymous attempted for Petition)",
      "content": {
        "application/problem+json": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "integer", "example": 422 },
            "detail": { "type": "string" }
          }
        }
      }
    }
  }
}
