{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetOfficialInboxContract",
  "description": "Retrieves the active assigned tickets (Status = InReview, max 5) for the currently authenticated staff official (GET /api/v1/assignments/my-inbox)",
  "endpoint": {
    "method": "GET",
    "path": "/api/v1/assignments/my-inbox",
    "authenticated": true,
    "requiredRole": "Funcionario"
  },
  "responses": {
    "200": {
      "description": "Active assigned tickets for the authenticated official",
      "content": {
        "application/json": {
          "type": "object",
          "required": ["isSuccess", "value"],
          "properties": {
            "isSuccess": { "type": "boolean", "const": true },
            "value": {
              "type": "object",
              "required": ["activeCount", "maxCapacity", "tickets"],
              "properties": {
                "activeCount": { "type": "integer", "minimum": 0, "maximum": 5, "example": 3 },
                "maxCapacity": { "type": "integer", "const": 5 },
                "tickets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "radicadoNumber",
                      "type",
                      "typeName",
                      "destinationAreaName",
                      "subject",
                      "description",
                      "assignedAtUtc",
                      "assignmentNote",
                      "dueDateUtc",
                      "remainingBusinessDays",
                      "urgencyLevel"
                    ],
                    "properties": {
                      "id": { "type": "string", "format": "uuid" },
                      "radicadoNumber": { "type": "string", "example": "2026-00000001" },
                      "type": { "type": "integer", "example": 1 },
                      "typeName": { "type": "string", "example": "Petición" },
                      "destinationAreaName": { "type": "string", "example": "Oficina Jurídica" },
                      "subject": { "type": "string", "example": "Solicitud de copia de acta de posesión" },
                      "description": { "type": "string", "example": "Por medio de la presente solicito..." },
                      "assignedAtUtc": { "type": "string", "format": "date-time" },
                      "assignmentNote": { "type": "string", "example": "Priorizar revisión" },
                      "dueDateUtc": { "type": "string", "format": "date-time" },
                      "remainingBusinessDays": { "type": "integer", "example": 2 },
                      "urgencyLevel": { "type": "string", "enum": ["Critical", "Attention", "OnTime"], "example": "Critical" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "401": {
      "description": "Unauthenticated"
    },
    "403": {
      "description": "Forbidden"
    }
  }
}
