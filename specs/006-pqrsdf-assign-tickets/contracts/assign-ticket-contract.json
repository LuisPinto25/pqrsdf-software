{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssignTicketContract",
  "description": "Assigns an unassigned PQRSDF ticket to a designated official, changing status to InReview (POST /api/v1/assignments/{radicado}/assign)",
  "endpoint": {
    "method": "POST",
    "path": "/api/v1/assignments/{radicado}/assign",
    "authenticated": true,
    "requiredRole": "Administrador"
  },
  "parameters": {
    "path": {
      "type": "object",
      "required": ["radicado"],
      "properties": {
        "radicado": { "type": "string", "example": "2026-00000001" }
      }
    }
  },
  "request": {
    "content": {
      "application/json": {
        "type": "object",
        "required": ["officialId"],
        "properties": {
          "officialId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the active Funcionario user to receive assignment"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "example": "Por favor priorizar atención debido a término legal perentorio",
            "description": "Optional administrative instruction note (max 500 characters)"
          }
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "Ticket assigned successfully; status transitioned to InReview",
      "content": {
        "application/json": {
          "type": "object",
          "required": ["isSuccess", "value"],
          "properties": {
            "isSuccess": { "type": "boolean", "const": true },
            "value": {
              "type": "object",
              "required": [
                "radicadoNumber",
                "status",
                "assignedToUserId",
                "assignedOfficialName",
                "assignedAtUtc",
                "message"
              ],
              "properties": {
                "radicadoNumber": { "type": "string", "example": "2026-00000001" },
                "status": { "type": "string", "const": "InReview" },
                "assignedToUserId": { "type": "string", "format": "uuid" },
                "assignedOfficialName": { "type": "string", "example": "Juan Carlos Pérez" },
                "assignedAtUtc": { "type": "string", "format": "date-time" },
                "message": { "type": "string", "example": "Solicitud asignada exitosamente al funcionario." }
              }
            }
          }
        }
      }
    },
    "400": {
      "description": "Validation error (invalid official ID or note length)"
    },
    "401": {
      "description": "Unauthenticated"
    },
    "403": {
      "description": "Forbidden - requires Administrador role"
    },
    "404": {
      "description": "Ticket not found"
    },
    "409": {
      "description": "Conflict: Ticket is not in Registered status, or official reached workload limit of 5 active tickets"
    }
  }
}
