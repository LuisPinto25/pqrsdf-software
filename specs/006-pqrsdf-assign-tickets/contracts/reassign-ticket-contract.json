{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReassignTicketContract",
  "description": "Reassigns an in-review PQRSDF ticket to a new official with mandatory justification (POST /api/v1/assignments/{radicado}/reassign)",
  "endpoint": {
    "method": "POST",
    "path": "/api/v1/assignments/{radicado}/reassign",
    "authenticated": true,
    "requiredRole": "Administrador"
  },
  "parameters": {
    "path": {
      "type": "object",
      "required": ["radicado"],
      "properties": {
        "radicado": { "type": "string", "example": "2026-00000001" }
      }
    }
  },
  "request": {
    "content": {
      "application/json": {
        "type": "object",
        "required": ["newOfficialId", "justification"],
        "properties": {
          "newOfficialId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the target active Funcionario to receive re-assignment"
          },
          "justification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "example": "Traslado por incapacidad médica del funcionario anterior para garantizar respuesta oportuna",
            "description": "Mandatory administrative justification reason (10 to 500 characters)"
          }
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "Ticket reassigned successfully; audit trail updated",
      "content": {
        "application/json": {
          "type": "object",
          "required": ["isSuccess", "value"],
          "properties": {
            "isSuccess": { "type": "boolean", "const": true },
            "value": {
              "type": "object",
              "required": [
                "radicadoNumber",
                "previousAssignedUserId",
                "newAssignedUserId",
                "newOfficialName",
                "reassignedAtUtc",
                "message"
              ],
              "properties": {
                "radicadoNumber": { "type": "string", "example": "2026-00000001" },
                "previousAssignedUserId": { "type": "string", "format": "uuid" },
                "newAssignedUserId": { "type": "string", "format": "uuid" },
                "newOfficialName": { "type": "string", "example": "María Fernanda Gómez" },
                "reassignedAtUtc": { "type": "string", "format": "date-time" },
                "message": { "type": "string", "example": "Solicitud reasignada exitosamente." }
              }
            }
          }
        }
      }
    },
    "400": {
      "description": "Validation error (justification shorter than 10 chars, missing target official)"
    },
    "401": {
      "description": "Unauthenticated"
    },
    "403": {
      "description": "Forbidden - requires Administrador role"
    },
    "404": {
      "description": "Ticket not found"
    },
    "409": {
      "description": "Conflict: Ticket is not in InReview, or new official reached 5-ticket workload limit, or target is already current assignee"
    }
  }
}
