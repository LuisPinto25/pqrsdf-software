{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetTicketManagementDetailContract",
  "description": "Contract for retrieving operational and citizen details of a ticket for internal management by authorized staff",
  "endpoint": {
    "path": "/api/v1/tickets/{radicado}/management-detail",
    "method": "GET",
    "authorization": "Bearer token (Roles: Funcionario, Administrador)",
    "request": {
      "pathParameters": {
        "radicado": {
          "type": "string",
          "pattern": "^PQRSDF-\\d{4}-\\d{6}$",
          "example": "PQRSDF-2026-000001"
        }
      }
    },
    "responses": {
      "200": {
        "description": "Operational ticket details retrieved successfully",
        "body": {
          "type": "object",
          "required": [
            "id", "radicadoNumber", "type", "typeName", "destinationAreaId", "destinationAreaName",
            "isAnonymous", "subject", "description", "filingDateUtc", "dueDateUtc",
            "remainingBusinessDays", "urgencyLevel", "status", "statusName", "isAssignedToCurrentUser", "canManage"
          ],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "radicadoNumber": { "type": "string", "example": "PQRSDF-2026-000001" },
            "type": { "type": "integer", "example": 1 },
            "typeName": { "type": "string", "example": "Petición" },
            "destinationAreaId": { "type": "string", "format": "uuid" },
            "destinationAreaName": { "type": "string", "example": "Atención al Ciudadano" },
            "isAnonymous": { "type": "boolean", "example": false },
            "applicant": {
              "type": ["object", "null"],
              "properties": {
                "documentType": { "type": "string", "example": "CC" },
                "documentNumber": { "type": "string", "example": "1098765432" },
                "fullName": { "type": "string", "example": "Carlos Rodríguez" },
                "email": { "type": "string", "example": "carlos@example.com" },
                "phone": { "type": "string", "example": "3001234567" }
              }
            },
            "subject": { "type": "string", "example": "Solicitud de información sobre trámite" },
            "description": { "type": "string", "example": "Por medio de la presente solicito..." },
            "filingDateUtc": { "type": "string", "format": "date-time" },
            "dueDateUtc": { "type": "string", "format": "date-time" },
            "remainingBusinessDays": { "type": ["integer", "null"], "example": 12 },
            "urgencyLevel": { "type": "string", "enum": ["Normal", "Attention", "Critical", "Expired"], "example": "Normal" },
            "status": { "type": "integer", "example": 3 },
            "statusName": { "type": "string", "example": "En trámite" },
            "assignedToUserId": { "type": ["string", "null"], "format": "uuid" },
            "assignedOfficialName": { "type": ["string", "null"], "example": "Juan Pérez" },
            "assignedAtUtc": { "type": ["string", "null"], "format": "date-time" },
            "assignmentNote": { "type": ["string", "null"], "example": "Revisar antecedentes en archivo." },
            "responseText": { "type": ["string", "null"], "example": null },
            "responseDateUtc": { "type": ["string", "null"], "format": "date-time" },
            "isAssignedToCurrentUser": { "type": "boolean", "example": true },
            "canManage": { "type": "boolean", "example": true },
            "statusHistory": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "previousStatus", "previousStatusName", "newStatus", "newStatusName", "changedByOfficialName", "justification", "changedAtUtc"],
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "previousStatus": { "type": "integer", "example": 3 },
                  "previousStatusName": { "type": "string", "example": "En trámite" },
                  "newStatus": { "type": "integer", "example": 3 },
                  "newStatusName": { "type": "string", "example": "En trámite" },
                  "changedByOfficialName": { "type": "string", "example": "Juan Pérez" },
                  "justification": { "type": "string", "example": "Se solicita concepto técnico..." },
                  "changedAtUtc": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        }
      },
      "401": { "description": "Unauthorized" },
      "404": { "description": "Ticket not found" }
    }
  }
}
