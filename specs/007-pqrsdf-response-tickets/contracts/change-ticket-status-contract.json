{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeTicketStatusContract",
  "description": "Contract for updating the operational status of an assigned ticket with mandatory justification",
  "endpoint": {
    "path": "/api/v1/tickets/{radicado}/status",
    "method": "POST",
    "authorization": "Bearer token (Roles: Funcionario, Administrador)",
    "request": {
      "pathParameters": {
        "radicado": {
          "type": "string",
          "pattern": "^PQRSDF-\\d{4}-\\d{6}$",
          "example": "PQRSDF-2026-000001"
        }
      },
      "body": {
        "type": "object",
        "required": ["newStatus", "justification"],
        "properties": {
          "newStatus": {
            "type": "integer",
            "enum": [3],
            "description": "Target operational status (InReview = 3)",
            "example": 3
          },
          "justification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "description": "Mandatory administrative explanation for the status change / milestone update",
            "example": "Se solicita concepto técnico adicional al área de planeación para sustentar la respuesta."
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "200": {
        "description": "Status successfully changed and audit history recorded",
        "body": {
          "type": "object",
          "required": ["radicadoNumber", "previousStatus", "newStatus", "statusName", "updatedAtUtc", "changedByOfficialName", "justification"],
          "properties": {
            "radicadoNumber": { "type": "string", "example": "PQRSDF-2026-000001" },
            "previousStatus": { "type": "integer", "example": 3 },
            "newStatus": { "type": "integer", "example": 3 },
            "statusName": { "type": "string", "example": "En trámite" },
            "updatedAtUtc": { "type": "string", "format": "date-time", "example": "2026-09-19T09:15:00Z" },
            "changedByOfficialName": { "type": "string", "example": "Juan Pérez" },
            "justification": { "type": "string", "example": "Se solicita concepto técnico adicional al área de planeación..." }
          }
        }
      },
      "400": {
        "description": "Validation error (justification empty or < 10 chars, or invalid status)",
        "body": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "example": "TicketStatusHistory.JustificationRequired" },
            "message": { "type": "string", "example": "Debe ingresar una justificación obligatoria de al menos 10 caracteres." }
          }
        }
      },
      "403": {
        "description": "Forbidden - Current user is not the assigned official and not an administrator",
        "body": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "example": "PqrsdfTicket.Forbidden" },
            "message": { "type": "string", "example": "No tiene autorización para gestionar el estado de esta solicitud." }
          }
        }
      },
      "404": {
        "description": "Ticket not found",
        "body": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "example": "PqrsdfTicket.NotFound" },
            "message": { "type": "string", "example": "No se encontró ninguna solicitud con el radicado especificado." }
          }
        }
      },
      "409": {
        "description": "Conflict - Cannot alter status of a closed ticket",
        "body": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "example": "PqrsdfTicket.AlreadyClosed" },
            "message": { "type": "string", "example": "No se puede cambiar el estado de una solicitud cerrada." }
          }
        }
      }
    }
  }
}
