{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProblemDetailsContract",
  "description": "Standard RFC 7807 error format emitted by GlobalExceptionHandler for unhandled exceptions",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri",
      "example": "https://datatracker.ietf.org/doc/html/rfc7231#section-6.6.1"
    },
    "title": {
      "type": "string",
      "example": "Error interno del servidor"
    },
    "status": {
      "type": "integer",
      "example": 500
    },
    "detail": {
      "type": "string",
      "example": "Ha ocurrido un error inesperado al procesar su solicitud. Por favor intente más tarde."
    },
    "instance": {
      "type": "string",
      "example": "/api/v1/system/status"
    },
    "traceId": {
      "type": "string",
      "example": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
    }
  },
  "required": ["title", "status", "detail"]
}
